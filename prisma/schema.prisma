// Prisma Schema for BalanceVault
// Configured for PostgreSQL (e.g. Neon, Supabase, or self-hosted)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  USER
}

enum UserStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  fullName           String
  role               Role                @default(USER)
  status             UserStatus          @default(PENDING_ONBOARDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  accounts           Account[]
  onboardingRequest  OnboardingRequest?
  auditLogs          AuditLog[]          @relation("UserAuditLogs")
  reviewedOnboardings OnboardingRequest[] @relation("ReviewerOnboardings")
}

model Account {
  id               String          @id @default(uuid())
  userId           String
  accountNumber    String          @unique
  currency         String          @default("USD")
  balance          Decimal         @default(0.00)
  availableBalance Decimal         @default(0.00)
  status           AccountStatus   @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id])
  outgoingTx       Transaction[]   @relation("SourceAccount")
  incomingTx       Transaction[]   @relation("DestinationAccount")
  ledgerEntries    LedgerEntry[]
}

model Transaction {
  id                   String            @id @default(uuid())
  reference            String            @unique
  sourceAccountId      String?
  destinationAccountId String?
  amount               Decimal
  fee                  Decimal           @default(0.00)
  currency             String            @default("USD")
  type                 TransactionType
  status               TransactionStatus @default(COMPLETED)
  idempotencyKey       String?           @unique
  description          String?
  createdAt            DateTime          @default(now())

  sourceAccount        Account?          @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount   Account?          @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  ledgerEntries        LedgerEntry[]
}

model LedgerEntry {
  id             String      @id @default(uuid())
  transactionId  String
  accountId      String
  entryType      EntryType
  amount         Decimal
  balanceAfter   Decimal
  sequenceNumber Int         @unique
  previousHash   String
  currentHash    String
  createdAt      DateTime    @default(now())

  transaction    Transaction @relation(fields: [transactionId], references: [id])
  account        Account     @relation(fields: [accountId], references: [id])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actorRole    String
  action       String
  entityType   String
  entityId     String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  previousHash String
  currentHash  String
  createdAt    DateTime @default(now())

  actor        User?    @relation("UserAuditLogs", fields: [actorId], references: [id])
}

model OnboardingRequest {
  id               String           @id @default(uuid())
  userId           String           @unique
  idDocumentType   String
  idDocumentNumber String
  occupation       String
  monthlyIncome    Decimal
  riskScore        Int              @default(15)
  status           OnboardingStatus @default(PENDING)
  reviewerId       String?
  reviewNotes      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  reviewer         User?            @relation("ReviewerOnboardings", fields: [reviewerId], references: [id])
}
